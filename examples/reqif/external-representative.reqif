<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="HDR-EXT-001">
      <COMMENT>Independent interoperability fixture for Systems-Modeler-Pro PR52.</COMMENT>
      <CREATION-TIME>2026-01-15T12:00:00Z</CREATION-TIME>
      <REQ-IF-TOOL-ID>ExternalFixtureAuthor</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <SOURCE-TOOL-ID>ExternalFixtureAuthor</SOURCE-TOOL-ID>
      <TITLE>Independent Vehicle Requirements</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT-STRING" LONG-NAME="String" MAX-LENGTH="4096"/>
        <DATATYPE-DEFINITION-XHTML IDENTIFIER="DT-XHTML" LONG-NAME="XHTML"/>
        <DATATYPE-DEFINITION-BOOLEAN IDENTIFIER="DT-BOOL" LONG-NAME="Boolean"/>
        <DATATYPE-DEFINITION-INTEGER IDENTIFIER="DT-INT" LONG-NAME="Integer" MIN="0" MAX="100"/>
        <DATATYPE-DEFINITION-REAL IDENTIFIER="DT-REAL" LONG-NAME="Real"/>
        <DATATYPE-DEFINITION-DATE IDENTIFIER="DT-DATE" LONG-NAME="Date"/>
        <DATATYPE-DEFINITION-ENUMERATION IDENTIFIER="DT-PRIORITY" LONG-NAME="Priority">
          <SPECIFIED-VALUES>
            <ENUM-VALUE IDENTIFIER="EV-LOW" LONG-NAME="Low"/>
            <ENUM-VALUE IDENTIFIER="EV-MEDIUM" LONG-NAME="Medium"/>
            <ENUM-VALUE IDENTIFIER="EV-HIGH" LONG-NAME="High"/>
          </SPECIFIED-VALUES>
        </DATATYPE-DEFINITION-ENUMERATION>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="T-REQ" LONG-NAME="System Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-REQ-ID" LONG-NAME="Requirement ID"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="A-REQ-TEXT" LONG-NAME="Requirement Text"><TYPE><DATATYPE-DEFINITION-XHTML-REF>DT-XHTML</DATATYPE-DEFINITION-XHTML-REF></TYPE></ATTRIBUTE-DEFINITION-XHTML>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-NAME" LONG-NAME="Name"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-DOC" LONG-NAME="Documentation"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-ENUMERATION IDENTIFIER="A-PRIORITY" LONG-NAME="Supplier Priority" MULTI-VALUED="false"><TYPE><DATATYPE-DEFINITION-ENUMERATION-REF>DT-PRIORITY</DATATYPE-DEFINITION-ENUMERATION-REF></TYPE></ATTRIBUTE-DEFINITION-ENUMERATION>
            <ATTRIBUTE-DEFINITION-BOOLEAN IDENTIFIER="A-APPROVED" LONG-NAME="Supplier Approved"><TYPE><DATATYPE-DEFINITION-BOOLEAN-REF>DT-BOOL</DATATYPE-DEFINITION-BOOLEAN-REF></TYPE></ATTRIBUTE-DEFINITION-BOOLEAN>
            <ATTRIBUTE-DEFINITION-INTEGER IDENTIFIER="A-RANK" LONG-NAME="Supplier Rank"><TYPE><DATATYPE-DEFINITION-INTEGER-REF>DT-INT</DATATYPE-DEFINITION-INTEGER-REF></TYPE></ATTRIBUTE-DEFINITION-INTEGER>
            <ATTRIBUTE-DEFINITION-REAL IDENTIFIER="A-COST" LONG-NAME="Supplier Cost"><TYPE><DATATYPE-DEFINITION-REAL-REF>DT-REAL</DATATYPE-DEFINITION-REAL-REF></TYPE></ATTRIBUTE-DEFINITION-REAL>
            <ATTRIBUTE-DEFINITION-DATE IDENTIFIER="A-REVIEW-DATE" LONG-NAME="Supplier Review Date"><TYPE><DATATYPE-DEFINITION-DATE-REF>DT-DATE</DATATYPE-DEFINITION-DATE-REF></TYPE></ATTRIBUTE-DEFINITION-DATE>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-CUSTOM" LONG-NAME="Supplier Custom Attribute"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPEC-OBJECT-TYPE IDENTIFIER="T-TEST" LONG-NAME="Verification TestCase">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-TEST-NAME" LONG-NAME="Name"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-TEST-CUSTOM" LONG-NAME="Supplier Test Procedure"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPEC-RELATION-TYPE IDENTIFIER="T-TRACE" LONG-NAME="Trace"><SPEC-ATTRIBUTES/></SPEC-RELATION-TYPE>
        <SPEC-RELATION-TYPE IDENTIFIER="T-VERIFY" LONG-NAME="Verify"><SPEC-ATTRIBUTES/></SPEC-RELATION-TYPE>
        <SPECIFICATION-TYPE IDENTIFIER="T-SPEC" LONG-NAME="Requirements Specification"><SPEC-ATTRIBUTES/></SPECIFICATION-TYPE>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="REQ-1" LONG-NAME="Startup Requirement">
          <TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-001"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-REQ-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>A-REQ-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The vehicle <xhtml:b>shall</xhtml:b> complete commanded startup.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Startup Requirement"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-NAME</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Imported from an independent supplier exchange."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-DOC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>A-PRIORITY</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>EV-HIGH</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-BOOLEAN THE-VALUE="true"><DEFINITION><ATTRIBUTE-DEFINITION-BOOLEAN-REF>A-APPROVED</ATTRIBUTE-DEFINITION-BOOLEAN-REF></DEFINITION></ATTRIBUTE-VALUE-BOOLEAN>
            <ATTRIBUTE-VALUE-INTEGER THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-INTEGER-REF>A-RANK</ATTRIBUTE-DEFINITION-INTEGER-REF></DEFINITION></ATTRIBUTE-VALUE-INTEGER>
            <ATTRIBUTE-VALUE-REAL THE-VALUE="12.5"><DEFINITION><ATTRIBUTE-DEFINITION-REAL-REF>A-COST</ATTRIBUTE-DEFINITION-REAL-REF></DEFINITION></ATTRIBUTE-VALUE-REAL>
            <ATTRIBUTE-VALUE-DATE THE-VALUE="2026-01-15T12:00:00Z"><DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>A-REVIEW-DATE</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION></ATTRIBUTE-VALUE-DATE>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CUSTOM-PRESERVE-1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-CUSTOM</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-2" LONG-NAME="Startup Timing Requirement">
          <TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-002"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-REQ-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>A-REQ-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:p>Startup shall complete within the allocated time.</xhtml:p></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>A-PRIORITY</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>EV-MEDIUM</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CUSTOM-PRESERVE-2"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-CUSTOM</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-3" LONG-NAME="Startup Indication Requirement">
          <TYPE><SPEC-OBJECT-TYPE-REF>T-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-003"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-REQ-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>A-REQ-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:p>The controller shall publish a startup-complete indication.</xhtml:p></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="TC-1" LONG-NAME="Verify Startup">
          <TYPE><SPEC-OBJECT-TYPE-REF>T-TEST</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Verify Startup"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-TEST-NAME</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Execute startup and record completion."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-TEST-CUSTOM</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPEC-RELATIONS>
        <SPEC-RELATION IDENTIFIER="REL-TRACE" LONG-NAME="Startup decomposition trace"><TYPE><SPEC-RELATION-TYPE-REF>T-TRACE</SPEC-RELATION-TYPE-REF></TYPE><SOURCE><SPEC-OBJECT-REF>REQ-1</SPEC-OBJECT-REF></SOURCE><TARGET><SPEC-OBJECT-REF>REQ-2</SPEC-OBJECT-REF></TARGET><VALUES/></SPEC-RELATION>
        <SPEC-RELATION IDENTIFIER="REL-VERIFY" LONG-NAME="Verification coverage"><TYPE><SPEC-RELATION-TYPE-REF>T-VERIFY</SPEC-RELATION-TYPE-REF></TYPE><SOURCE><SPEC-OBJECT-REF>TC-1</SPEC-OBJECT-REF></SOURCE><TARGET><SPEC-OBJECT-REF>REQ-1</SPEC-OBJECT-REF></TARGET><VALUES/></SPEC-RELATION>
      </SPEC-RELATIONS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="SPEC-VEHICLE" LONG-NAME="Vehicle Startup Requirements"><TYPE><SPECIFICATION-TYPE-REF>T-SPEC</SPECIFICATION-TYPE-REF></TYPE><CHILDREN>
          <SPEC-HIERARCHY IDENTIFIER="H-REQ-1"><OBJECT><SPEC-OBJECT-REF>REQ-1</SPEC-OBJECT-REF></OBJECT><CHILDREN>
            <SPEC-HIERARCHY IDENTIFIER="H-REQ-2"><OBJECT><SPEC-OBJECT-REF>REQ-2</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
            <SPEC-HIERARCHY IDENTIFIER="H-REQ-3"><OBJECT><SPEC-OBJECT-REF>REQ-3</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
          </CHILDREN></SPEC-HIERARCHY>
          <SPEC-HIERARCHY IDENTIFIER="H-TC-1"><OBJECT><SPEC-OBJECT-REF>TC-1</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
        </CHILDREN></SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
